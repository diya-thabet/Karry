# Karry Platform — development environment (Docker Compose)
# Copy to `.env` and adjust per environment. Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=karry
POSTGRES_PASSWORD=karry_dev
POSTGRES_DB=karry

# --- MinIO ---
MINIO_ROOT_USER=karry
MINIO_ROOT_PASSWORD=karry_dev_minio

# --- JWT (backend) ---
# WARNING: dev-only value. Use a long random secret in production (e.g. openssl rand -hex 64).
JWT_SECRET=CHANGE_ME_IN_DEV_ONLY_NOT_FOR_PROD
